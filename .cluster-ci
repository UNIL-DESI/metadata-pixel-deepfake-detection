# =========================================================================================
# ⚠️ AI AGENT INSTRUCTIONS (JOULES / CURSOR) ⚠️
# Configuration pour Cluster-CI.
#
# REQUIRED_RAM: Contrainte de placement RAM (ex: 16GB). Défaut: 2GB.
# REQUIRED_VRAM: Contrainte de placement VRAM GPU (ex: 24GB). Défaut: 0.
# MAX_RUNTIME_HOURS: Durée maximale du job (max 24h). OBLIGATOIRE.
# EXPOSED_PORT: Port à exposer (ex: 8501). Active le routage pour une interface web.
#
# Liste ensuite les stages DVC à exécuter (un par ligne ou séparés par des espaces).
# Laisse vide après les variables pour tout exécuter (dvc repro).
# =========================================================================================
# ── Resource Requirements ──
REQUIRED_RAM=32GB
REQUIRED_VRAM=8GB
MAX_RUNTIME_HOURS=2

# isipol09 (x86, RTX 3090) is the worker this repo has always run on, and the
# image below is matched to its driver. The ARM GB10 workers need another image.
ALLOWED_WORKERS=isipol09

# ── Execution Control ──
#STAGES=prepare_dataset,catalog,extract_metadata,preprocess_metadata,analyze_metadata,predict_dataset_origin,cross_dataset_metadata,metadata_bias_screening,metadata_within_dataset_analysis

#STAGES(original)=dvc-code-analysis, prepare_dataset, catalog, extract_frames, extract_regions, extract_handcrafted, aggregate_handcrafted, extract_cnn, aggregate_cnn, extract_metadata,analyze_metadata,preprocess_metadata, align_features, split_dataset, feature_selection,train_models, final_evaluation
#STAGES(supported)=metadata_within_dataset_analysis, metadata_bias_screening, cross_dataset_metadata, predict_dataset_origin, ablation_study, feature_analysis 
#STAGES=all
#STAGES=hybrid_hybrid_pilot_001
STAGES=hybrid_hybrid_pilot_001

# ── Docker ──
# 25.06 matches isipol09's driver (575.57.08, CUDA 12.9). Changing the image
# also makes Cluster-CI rebuild the job volume, which clears the broken
# dvc-viewer install left by a cancelled run.
DOCKER_IMAGE_AMD64=nvcr.io/nvidia/pytorch:25.06-py3